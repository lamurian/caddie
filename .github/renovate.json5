// Renovate config (docs/adr/0013-dev-tooling.md). Everything automerges once
// the required `check` CI job passes; branch protection on main enforces it.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':dependencyDashboard',
    'helpers:pinGitHubActionDigests',
  ],
  schedule: ['before 6am on monday'],
  minimumReleaseAge: '3 days',
  osvVulnerabilityAlerts: true,
  automerge: true,
  automergeType: 'pr',
  platformAutomerge: true,
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 6am on monday'],
  },
  vulnerabilityAlerts: {
    schedule: ['at any time'],
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      description: 'Bump the Go toolchain in mise.toml and go.mod together',
      matchDepNames: ['go'],
      groupName: 'go toolchain',
    },
    {
      description: 'Group the dev tools pinned in mise.toml',
      matchManagers: ['mise'],
      matchDepNames: ['!go'],
      groupName: 'mise dev tools',
    },
    {
      description: 'Group GitHub Actions',
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
  ],
}

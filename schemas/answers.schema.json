{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lamurian/caddie/schemas/answers.schema.json",
  "title": "Caddie answers.yml",
  "description": "Stored interview and form answers (ADR 0007). Lookup order: posting:<slug>, company:<x>, global. Enforced by caddie validate.",
  "type": ["object", "null"],
  "additionalProperties": false,
  "properties": {
    "global": { "$ref": "#/$defs/answers" },
    "company": { "$ref": "#/$defs/named" },
    "posting": { "$ref": "#/$defs/named" }
  },
  "$defs": {
    "answers": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "named": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/answers" }
    }
  }
}
